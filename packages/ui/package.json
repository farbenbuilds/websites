{
  "name": "@farben/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared shadcn-svelte components for Farben's web apps.",
  "type": "module",
  "exports": {
    "./theme.css": "./src/lib/styles/theme.css",
    "./editorial.css": "./src/lib/styles/editorial.css",
    "./utils": "./src/lib/utils.ts",
    "./utils.js": "./src/lib/utils.ts",
    "./components/*": "./src/lib/components/*/index.ts",
    "./components/*.js": "./src/lib/components/*.ts",
    "./components/*.svelte": "./src/lib/components/*.svelte",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@lucide/svelte": "^1.70.0",
    "cn": "^0.5.2",
    "shadcn-svelte": "^1.7.2",
    "tailwind-variants": "^4.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "svelte": "catalog:",
    "svelte-check": "^4.7.8",
    "typescript": "catalog:"
  }
}
