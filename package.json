{
  "name": "websites",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:size && pnpm check:css && pnpm test:all && pnpm validate:docs && pnpm build",
    "lint": "vp lint -c .oxlintrc.json --type-aware --type-check",
    "lint:fix": "vp lint -c .oxlintrc.json --fix",
    "format": "vp fmt -c .oxfmtrc.json",
    "format:check": "vp fmt -c .oxfmtrc.json --check",
    "typecheck": "vp run -r check",
    "build": "vp run -r build",
    "check:uwz": "vp run uwz-docs#check",
    "check:vws": "vp run vws-docs#check",
    "check:ui": "vp run @farben/ui#check",
    "build:uwz": "vp run uwz-docs#build",
    "build:vws": "vp run vws-docs#build",
    "preview:uwz": "vp run uwz-docs#preview",
    "preview:vws": "vp run vws-docs#preview",
    "doctor:uwz": "vp run uwz-docs#doctor",
    "doctor:vws": "vp run vws-docs#doctor",
    "validate:docs": "vp run -r validate",
    "audit:uwz": "vp run uwz-docs#build && vp run uwz-docs#audit",
    "test:workspace": "vp run --filter uwz-docs --filter vws-docs test",
    "test:all": "pnpm test && pnpm test:workspace",
    "test": "vp test",
    "test:watch": "vp test watch",
    "check:size": "node scripts/check-file-size.mjs",
    "check:css": "node scripts/check-tailwind-css.mjs",
    "i18n:check": "x18n check",
    "lint:staged": "vp lint -c .oxlintrc.json --fix",
    "format:staged": "vp fmt -c .oxfmtrc.json --write --no-error-on-unmatched-pattern",
    "dev:uwz": "vp run uwz-docs#dev",
    "dev:vws": "vp run vws-docs#dev"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "catalog:",
    "@x18n/cli": "catalog:",
    "@x18n/core": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-astro": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "svelte": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
