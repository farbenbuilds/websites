---
import { isExternalHref, type InlinePart } from "./inline-text.ts";

type Props = {
  part: InlinePart;
};

const { part } = Astro.props;
const external = part.kind === "link" && isExternalHref(part.href);
---

{part.kind === "code" && <code>{part.value}</code>}
{part.kind === "strong" && <strong>{part.value}</strong>}
{part.kind === "link" && (
  <a
    href={part.href}
    target={external ? "_blank" : undefined}
    rel={external ? "noreferrer" : undefined}
    aria-describedby={external ? "blume-new-tab-hint" : undefined}
  >
    {part.value}
  </a>
)}
{part.kind === "text" && part.value}
