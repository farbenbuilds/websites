---
import SectionHeader from "../section-header/section-header.astro";
import { BENCHMARK_URL, HTTP_ARENA_FRAMEWORK_URL } from "../../site-links.ts";
import { benchmarkCopy, type BenchmarkLocale } from "./benchmark-section-data";

type Props = {
  locale?: BenchmarkLocale;
};

const { locale = "en" } = Astro.props;
const copy = benchmarkCopy(locale);
---

<section class="docs-home-section" id="benchmark" aria-labelledby="benchmark-heading">
  <SectionHeader
    headingId="benchmark-heading"
    label={copy.label}
    heading={copy.heading}
    intro={copy.intro}
  />
  <div class="docs-home-benchmark">
    <div class="docs-home-benchmark-head">
      <div>
        <p class="editorial-label">{copy.benchLabel}</p>
        <h3>{copy.benchHeading}</h3>
      </div>
      <a
        class="editorial-link"
        href={BENCHMARK_URL}
        target="_blank"
        rel="noreferrer"
        aria-describedby="blume-new-tab-hint"
      >
        {"bench.zig.bd "}
        <span aria-hidden="true">{"->"}</span>
      </a>
    </div>
    <p class="docs-home-benchmark-meta">{copy.benchMeta}</p>
    <ol class="docs-home-bars" aria-label={copy.benchAria}>
      {copy.bars.map((bar) => (
        <li class={`docs-home-bar-row${bar.leader ? " docs-home-bar-row-leader" : ""}`}>
          <span class="docs-home-bar-name">{bar.name}</span>
          <span class="docs-home-bar-track" aria-hidden="true">
            <span
              class={`docs-home-bar-fill${bar.leader ? " docs-home-bar-leader" : ""}`}
              style={`--bar-width: ${bar.share}%`}
            />
          </span>
          <span class="docs-home-bar-value">{bar.value}</span>
        </li>
      ))}
    </ol>
    <p class="docs-home-benchmark-source">{copy.benchSource}</p>
  </div>
  <div class="docs-home-arena">
    <div class="docs-home-benchmark-head">
      <div>
        <p class="editorial-label">{copy.arenaLabel}</p>
        <h3>{copy.arenaHeading}</h3>
      </div>
      <a
        class="editorial-link"
        href={HTTP_ARENA_FRAMEWORK_URL}
        target="_blank"
        rel="noreferrer"
        aria-describedby="blume-new-tab-hint"
      >
        {copy.arenaLink}
        <span aria-hidden="true">{" ->"}</span>
      </a>
    </div>
    <p class="docs-home-benchmark-meta">{copy.arenaMeta}</p>
    <dl class="docs-home-arena-metrics">
      {copy.arenaMetrics.map((metric) => (
        <div class="docs-home-arena-metric">
          <dt>{metric.label}</dt>
          <dd class="docs-home-arena-value-row">
            <span class="docs-home-arena-value">{metric.value}</span>
            <span class="docs-home-arena-unit">{metric.unit}</span>
          </dd>
          <dd class="docs-home-arena-detail">{metric.detail}</dd>
        </div>
      ))}
    </dl>
    <p class="docs-home-benchmark-source">{copy.arenaSource}</p>
  </div>
</section>
