---
import { isExternalHref } from "@farben/docs-components/inline-text.ts";

import {
  SITE_LINKS,
  localizeHref,
  resolveLocale,
  siteColophonLabel,
  siteFooterNote,
  type SiteLocale,
} from "../../site-links";

type Props = {
  locale?: SiteLocale;
};

const { locale } = Astro.props;
const resolvedLocale = locale ?? resolveLocale(Astro.url.pathname);

const label = siteColophonLabel(resolvedLocale);
---

<footer class="site-colophon" aria-label={label}>
  <ul class="site-colophon-links" role="list">
    {SITE_LINKS.map((link) => {
      const href = localizeHref(link.href, resolvedLocale);
      const external = isExternalHref(href);
      return (
        <li>
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noreferrer" : undefined}
            aria-describedby={external ? "blume-new-tab-hint" : undefined}
          >
            {link.label[resolvedLocale]}
          </a>
        </li>
      );
    })}
  </ul>
  <p>{siteFooterNote(resolvedLocale)}</p>
</footer>
