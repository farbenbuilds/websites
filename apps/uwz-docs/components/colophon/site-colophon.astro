---
import { isExternalHref } from "@farben/docs-components/inline-text.ts";

import {
  SITE_LINKS,
  localizeHref,
  resolveLocale,
  siteColophonLabel,
  siteFooterNote,
  type SiteLocale,
} from "../../site-links";

type Props = {
  locale?: SiteLocale;
};

const { locale } = Astro.props;
const resolvedLocale = locale ?? resolveLocale(Astro.url.pathname);

const label = siteColophonLabel(resolvedLocale);
---

<footer class="docs-home-colophon" aria-label={label}>
  <ul class="docs-home-colophon-links" role="list">
    {SITE_LINKS.map((link) => (
      <li>
        <a
          href={localizeHref(link.href, resolvedLocale)}
          target={isExternalHref(link.href) ? "_blank" : undefined}
          rel={isExternalHref(link.href) ? "noreferrer" : undefined}
          aria-describedby={isExternalHref(link.href) ? "blume-new-tab-hint" : undefined}
        >
          {link.label[resolvedLocale]}
        </a>
      </li>
    ))}
  </ul>
  <p>{siteFooterNote(resolvedLocale)}</p>
</footer>
