---
import SectionHeader from "../section-header/section-header.astro";
import { landingCopy, type LandingLocale } from "./landing-copy.ts";

type Props = {
  locale?: LandingLocale;
};

const { locale = "en" } = Astro.props;
const copy = landingCopy(locale).server;
---

<section class="docs-home-section" id="server" aria-labelledby="server-heading">
  <SectionHeader
    headingId="server-heading"
    label={copy.label}
    heading={copy.heading}
    intro={copy.intro}
  />
  <ol class="docs-home-steps" role="list">
    {copy.steps.map((step, index) => (
      <li class="docs-home-step">
        <span class="docs-home-step-number" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
  <div class="docs-home-server-cta">
    <p>{copy.ctaText}</p>
    <a class="editorial-link" href={copy.cta.href}>
      {copy.cta.label}
      <span aria-hidden="true">{"->"}</span>
    </a>
  </div>
</section>
