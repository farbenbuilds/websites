---
import { Image } from "astro:assets";

import { landingCopy, type LandingLocale } from "./landing-copy.ts";
import sponsorLogo from "./assets/farben-logo.png";

type Props = {
  locale?: LandingLocale;
};

const { locale = "en" } = Astro.props;
const copy = landingCopy(locale).sponsor;
---

<section class="docs-home-section docs-home-sponsor" id="sponsor" aria-labelledby="sponsor-heading">
  <div class="docs-home-section-head">
    <p class="editorial-label">{copy.label}</p>
    <div class="docs-home-author-card">
      <Image
        class="docs-home-author-avatar"
        src={sponsorLogo}
        alt={copy.logoAlt}
        width={256}
        height={256}
        loading="lazy"
        decoding="async"
      />
      <div class="docs-home-author-copy">
        <h2 id="sponsor-heading">{copy.heading}</h2>
        <p>{copy.body}</p>
        <a
          class="editorial-action editorial-action-secondary"
          href={copy.action.href}
          target="_blank"
          rel="noreferrer"
          aria-describedby="blume-new-tab-hint"
        >
          {copy.action.label}
          <span aria-hidden="true">{"->"}</span>
        </a>
      </div>
    </div>
  </div>
</section>
