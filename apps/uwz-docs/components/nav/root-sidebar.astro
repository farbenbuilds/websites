---
import type { NavNode, UIStrings } from "blume";
import NavTree from "blume/components/layout/NavTree.astro";

type Props = {
  items: NavNode[];
  currentRoute: string;
  fragmentBase?: string;
  ids?: Map<NavNode, string>;
  strings?: UIStrings["nav"];
};

const { items, currentRoute, fragmentBase, ids, strings } = Astro.props;

// Blume wraps the /docs folder in a "Documentation" group. Flatten it so its
// pages and subgroups sit at the sidebar root without changing their routes.
const rootItems = items.flatMap((item) =>
  item.kind === "group" && (item.route === "/docs" || item.route === "/vi/docs")
    ? item.children
    : [item],
);
---

<NavTree
  currentRoute={currentRoute}
  fragmentBase={fragmentBase}
  ids={ids}
  items={rootItems}
  strings={strings}
/>
